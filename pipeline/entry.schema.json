{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/omidhey/world-history-map/blob/main/pipeline/entry.schema.json",
  "title": "Entry",
  "description": "One person, work, invention, ruler, dynasty, culture or environmental event. Documented in docs/schema.md; extra checks (year 0, start after end, duplicate ids) live in pipeline/validate.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "category", "start", "date_precision", "location", "summary", "sources"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 80,
      "description": "Stable identifier, lowercase words joined by hyphens. Must equal the file name without .json."
    },
    "wikidata": {
      "type": "string",
      "pattern": "^Q[1-9][0-9]*$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "category": {
      "enum": ["philosopher", "scientist", "writer", "work", "invention", "ruler", "dynasty", "culture", "event"]
    },
    "start": {
      "type": "integer",
      "description": "Birth, founding, composition or first known date. Negative = BCE, no year 0."
    },
    "end": {
      "type": "integer",
      "description": "Death, end, or completion. Omit when there is none (most works and inventions)."
    },
    "date_precision": {
      "enum": ["day", "year", "circa", "decade", "century"]
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lat", "lon", "place"],
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 },
        "place": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 20,
      "maxLength": 400,
      "description": "One or two sentences in the contributor's own words (CC BY-SA 4.0)."
    },
    "links": {
      "type": "object",
      "additionalProperties": { "type": "string", "pattern": "^https?://" }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 10 },
      "description": "Links, or author + title + page for print sources."
    },
    "disputed": { "type": "boolean" },
    "claims": {
      "type": "array",
      "minItems": 2,
      "description": "Competing sourced values when sources disagree; requires disputed: true.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "value", "sources"],
        "properties": {
          "field": { "enum": ["start", "end"] },
          "value": { "type": "integer" },
          "note": { "type": "string", "maxLength": 300 },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 10 }
          }
        }
      }
    }
  }
}
