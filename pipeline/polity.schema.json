{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/omidhey/world-history-map/blob/main/pipeline/polity.schema.json",
  "title": "Polity",
  "description": "One state, empire, kingdom or similar, linked to the names it carries in the border snapshots. Documented in docs/schema.md; extra checks live in pipeline/validate.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "border_names",
    "type",
    "start",
    "date_precision",
    "summary",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 80,
      "description": "Stable identifier, lowercase words joined by hyphens. Must equal the file name without .json."
    },
    "wikidata": {
      "type": "string",
      "pattern": "^Q[1-9][0-9]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Common English name of the state."
    },
    "border_names": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Exact NAME values in data/borders/*.geojson that this state covers. Checked against the snapshots."
    },
    "type": {
      "enum": [
        "empire",
        "kingdom",
        "republic",
        "city-state",
        "caliphate",
        "sultanate",
        "khanate",
        "confederation",
        "state",
        "other"
      ]
    },
    "start": {
      "type": "integer",
      "description": "Founding year. Negative = BCE, no year 0."
    },
    "end": {
      "type": "integer",
      "description": "Year it ended. Omit when it still exists."
    },
    "date_precision": {
      "enum": [
        "day",
        "year",
        "circa",
        "decade",
        "century"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 20,
      "maxLength": 400,
      "description": "One or two sentences in the contributor's own words (CC BY-SA 4.0)."
    },
    "links": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^https?://"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 10
      },
      "description": "Links, or author + title + page for print sources."
    },
    "disputed": {
      "type": "boolean"
    },
    "claims": {
      "type": "array",
      "minItems": 2,
      "description": "Competing sourced values when sources disagree; requires disputed: true.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "value",
          "sources"
        ],
        "properties": {
          "field": {
            "enum": [
              "start",
              "end"
            ]
          },
          "value": {
            "type": "integer"
          },
          "note": {
            "type": "string",
            "maxLength": 300
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 10
            }
          }
        }
      }
    },
    "capital": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lat",
        "lon",
        "place"
      ],
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "place": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "description": "Main capital, if it had one."
    }
  }
}
