{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/omidhey/world-history-map/blob/main/pipeline/ruler.schema.json",
  "title": "Ruler",
  "description": "One ruler of a polity. start/end are the reign, not birth and death. Documented in docs/schema.md; extra checks live in pipeline/validate.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "polity",
    "title",
    "start",
    "date_precision",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 80,
      "description": "Stable identifier, lowercase words joined by hyphens. Must equal the file name without .json."
    },
    "wikidata": {
      "type": "string",
      "pattern": "^Q[1-9][0-9]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Common English name of the ruler."
    },
    "start": {
      "type": "integer",
      "description": "First year of the reign. Negative = BCE, no year 0."
    },
    "end": {
      "type": "integer",
      "description": "Last year of the reign. Omit if unknown."
    },
    "date_precision": {
      "enum": [
        "day",
        "year",
        "circa",
        "decade",
        "century"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 20,
      "maxLength": 400,
      "description": "One or two sentences in the contributor's own words (CC BY-SA 4.0)."
    },
    "links": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^https?://"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 10
      },
      "description": "Links, or author + title + page for print sources."
    },
    "disputed": {
      "type": "boolean"
    },
    "claims": {
      "type": "array",
      "minItems": 2,
      "description": "Competing sourced values when sources disagree; requires disputed: true.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "value",
          "sources"
        ],
        "properties": {
          "field": {
            "enum": [
              "start",
              "end"
            ]
          },
          "value": {
            "type": "integer"
          },
          "note": {
            "type": "string",
            "maxLength": 300
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 10
            }
          }
        }
      }
    },
    "polity": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 80,
      "description": "Id of the polity in data/polities/ this record belongs to."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "description": "Title held: king, emperor, caliph, pharaoh..."
    },
    "dynasty": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 80,
      "description": "Id of the dynasty in data/dynasties/, if the ruler belonged to one."
    }
  }
}
